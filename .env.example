# ============================================================
# DATAMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and adjust values for your local environment.
# DO NOT commit real secrets or API keys to version control.
# ============================================================

# --- SERVER CONFIGURATION ---
PORT=3000
ML_PORT=8000
NODE_ENV=development

# --- PYTHON EXECUTABLE ---
# Path to your Python interpreter with dependencies installed.
# On Windows with venv: .\.venv\Scripts\python.exe
# On Linux/macOS with venv: .venv/bin/python
PYTHON_EXECUTABLE=python

# --- LOCAL AUTHENTICATION ---
# Secret key used for session cookie signing / state protection.
# For production, provide a strong 32+ character random secret.
AUTH_SECRET=replace-with-a-random-secure-secret-key-min-32-chars

# --- GOOGLE GEMINI AI CONFIGURATION (OPTIONAL) ---
# Required for Gemini-powered executive insights and conversational assistant.
# If omitted or unavailable, DataMind automatically falls back to its
# deterministic rule-based local data analysis engine.
GEMINI_API_KEY="your-gemini-api-key-here"

# Application URL (used for self-referential links or deployment callbacks)
APP_URL="http://localhost:3000"

# Gemini model selection (Flash-Lite optimized for fast tabular insights)
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
GEMINI_SECONDARY_FALLBACK_MODEL="gemini-3.5-flash-lite"
